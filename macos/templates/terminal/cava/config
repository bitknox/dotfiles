## cava for the {{ meta.name }} rice, rendered from ~/dotfiles/macos/templates/terminal/cava/config.
## cava taps the system output through Core Audio (macOS 14.2 and later). The first run asks for
## System Audio Recording permission for the terminal.

[general]
framerate = 60
bar_width = 4
bar_spacing = 2
; stop drawing after 5 seconds of silence to save CPU while nothing plays
sleep_timer = 5

[input]
; tap is everything the Mac plays, mixed to stereo; tap_mono folds it to one channel
method = coreaudio
source = tap

[output]
method = noncurses
orientation = bottom

[color]
; bottom to top
gradient = 1
gradient_color_1 = '{{ accent }}'
gradient_color_2 = '{{ accent2 }}'
gradient_color_3 = '{{ highlight }}'

[smoothing]
monstercat = 1
noise_reduction = 77
