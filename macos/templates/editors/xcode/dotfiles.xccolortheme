		<key>xcode.syntax.regex.number</key>
		<string>{{ warn | float }} 1</string>
		<key>xcode.syntax.regex.other</key>
		<string>{{ subtext | float }} 1</string>
		<key>xcode.syntax.string</key>
		<string>{{ ok | float }} 1</string>
