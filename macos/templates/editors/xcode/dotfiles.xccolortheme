<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ meta.name }}: Xcode color theme, generated from the dotfiles palette by render.py.
     Xcode names the theme after the file; the install step saves one file per theme.
     Fonts use Maple Mono NF PostScript names; Xcode falls back to its default font when they are missing. -->
<plist version="1.0">
<dict>
	<key>DVTConsoleDebuggerInputTextColor</key>
	<string>{{ text | float }} 1</string>
	<key>DVTConsoleDebuggerInputTextFont</key>
	<string>MapleMono-NF-Regular - 13.0</string>
	<key>DVTConsoleDebuggerOutputTextColor</key>
	<string>{{ subtext | float }} 1</string>
	<key>DVTConsoleDebuggerOutputTextFont</key>
	<string>MapleMono-NF-Regular - 13.0</string>
	<key>DVTConsoleDebuggerPromptTextColor</key>
	<string>{{ accent | float }} 1</string>
	<key>DVTConsoleDebuggerPromptTextFont</key>
	<string>MapleMono-NF-Bold - 13.0</string>
	<key>DVTConsoleExectuableInputTextColor</key>
	<string>{{ text | float }} 1</string>
	<key>DVTConsoleExectuableInputTextFont</key>
