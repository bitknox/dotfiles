# brew bundle --file macos/Brewfile   (install/brew.sh runs this)

tap "FelixKratz/formulae"

# Window borders
brew "FelixKratz/formulae/borders"

# Shell
brew "starship"
brew "fastfetch"
brew "zoxide"
brew "eza"
brew "bat"
brew "fzf"
brew "yazi"
brew "cava"

# Apps
brew "spicetify-cli"
# Apps already in /Applications (installed by hand) are left alone; replacing them needs sudo.
{ "ghostty" => "Ghostty", "raycast" => "Raycast", "zen" => "Zen", "helium-browser" => "Helium" }.each do |c, app|
  cask c unless File.exist?("/Applications/#{app}.app")
end

# Fonts
cask "font-maple-mono-nf"
# SF Pro: install/brew.sh unpacks Apple's font-sf-pro download into ~/Library/Fonts, because the
# cask itself runs Apple's installer with sudo.
cask "font-shippori-mincho"
