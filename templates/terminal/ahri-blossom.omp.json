{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "✿ {{ .Folder }}",
  "palette": {
    "base": "{{ base }}",
    "pill": "{{ surface0 }}",
    "muted": "{{ overlay }}",
    "text": "{{ text }}",
    "sakura": "{{ sakura }}",
    "blossom": "{{ blossom }}",
    "lavender": "{{ lavender }}",
    "spirit": "{{ spirit }}",
    "gold": "{{ gold }}",
    "mint": "{{ mint }}",
    "rose": "{{ rose }}",
    "peach": "{{ peach }}",
    "sky": "{{ sky }}"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:sakura",
          "background": "p:pill",
          "template": "✿ {{ path .Path .Location }}",
          "options": { "style": "agnoster_short", "max_depth": 3, "folder_separator_icon": " <p:muted>›</> ", "home_icon": "~" }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "p:lavender",
          "background": "p:pill",
          "template": " {{ .HEAD }}{{ if .BranchStatus }} <p:spirit>{{ .BranchStatus }}</>{{ end }}{{ if .Working.Changed }} <p:gold> {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <p:mint> {{ .Staging.String }}</>{{ end }}",
          "options": { "fetch_status": true, "fetch_upstream_icon": false, "branch_icon": "", "branch_template": "{{ trunc 28 .Branch }}" }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:gold",
          "template": " <p:muted>via</>  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}",
          "options": { "display_mode": "files", "fetch_virtual_env": true }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:mint",
          "template": " <p:muted>via</>  {{ .Full }}",
          "options": { "display_mode": "files", "fetch_package_manager": false }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:sky",
          "template": " <p:muted>via</>  {{ .Full }}",
          "options": { "display_mode": "files" }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:peach",
          "template": " <p:muted>via</>  {{ .Full }}",
          "options": { "display_mode": "files" }
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "p:lavender",
          "template": " <p:muted>via</>  {{ .Full }}",
          "options": { "display_mode": "files" }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:spirit",
          "template": " <p:muted>took</> {{ .FormattedMs }}",
          "options": { "threshold": 2000, "style": "austin" }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:sakura",
          "foreground_templates": ["{{ if gt .Code 0 }}p:rose{{ end }}"],
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:sakura",
    "foreground_templates": ["{{ if gt .Code 0 }}p:rose{{ end }}"],
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "p:muted",
    "template": "❯❯ "
  }
}
