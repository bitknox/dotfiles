## cava — Ahri Blossom (rendered from ~/dotfiles/templates/terminal/cava/config)
## Windows: input is WASAPI loopback of the default output device (no setup needed).

[general]
framerate = 60
bar_width = 4
bar_spacing = 2
; stop drawing after 5s of silence (saves CPU while nothing plays)
sleep_timer = 5

[output]
method = noncurses
orientation = bottom

[color]
; bottom -> top
gradient = 1
gradient_color_1 = '{{ spirit }}'
gradient_color_2 = '{{ lavender }}'
gradient_color_3 = '{{ sakura }}'

[smoothing]
monstercat = 1
noise_reduction = 77
